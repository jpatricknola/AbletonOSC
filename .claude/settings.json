{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-pr-target.sh",
            "timeout": 10,
            "statusMessage": "Checking PR target"
          }
        ]
      }
    ]
  }
}
